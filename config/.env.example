# Environment Variables Template
# Copy this file to config/.env and fill in your API keys
# NEVER commit the actual .env file with real keys

# Image Generation
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com
OPENAI_COMPATIBLE_API_KEY=your_openai_compatible_api_key_here
OPENAI_COMPATIBLE_BASE_URL=https://your-openai-compatible-base-url
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# Content Research
JINA_API_KEY=your_jina_api_key_here

# Search
GOOGLE_SEARCH_API_KEY=your_google_search_api_key_here
GOOGLE_SEARCH_ENGINE_ID=your_google_search_engine_id_here
SERPER_API_KEY=your_serper_api_key_here

# Optional
OPENROUTER_API_KEY=your_openrouter_api_key_here
DIFY_API_URL=your_dify_api_url_here
DIFY_API_KEY=your_dify_api_key_here
